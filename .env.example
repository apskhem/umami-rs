# Required. A `?schema=<name>` parameter selects a Postgres schema, as upstream.
DATABASE_URL=postgresql://umami:umami@localhost:5432/umami

# Used for hashing/signing; falls back to DATABASE_URL when unset (as upstream).
APP_SECRET=replace-me-with-a-random-string

# Optional
# DIRECT_DATABASE_URL=     # run migrations against this URL instead (e.g. bypass a pooler)
# HOST=0.0.0.0
# PORT=3000
# BASE_PATH=/analytics
# SKIP_DB_CHECK=1          # skip version check and migrations at startup
# SKIP_DB_MIGRATION=1      # skip migrations at startup
# CORS_MAX_AGE=86400

# Event collection (/api/send)
# COLLECT_API_ENDPOINT=/api/collect   # extra path that serves /api/send
# DISABLE_BOT_CHECK=1
# IGNORE_IP=203.0.113.7,10.0.0.0/8    # addresses and CIDR ranges to drop
# CLIENT_IP_HEADER=x-client-ip        # read the client IP from this header first
# SALT_ROTATION=month                 # day | week | month: how often session IDs rotate
# REMOVE_TRAILING_SLASH=1
# SKIP_LOCATION_HEADERS=1             # ignore CDN geolocation headers
# GEOLITE_DB_PATH=geo/GeoLite2-City.mmdb
# USE_UUIDV7=1                        # v7 instead of v4 event IDs
# RUST_LOG=info,umami_server=debug,tower_http=debug
